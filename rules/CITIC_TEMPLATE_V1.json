{
  "schema_version": "1.0",
  "rule_id": "CITIC_TEMPLATE_V1",
  "bank_code": "CITIC",
  "status": "active",
  "priority": 98,
  "match_rules": {
    "sender_patterns": [
      "citiccard@bill.citiccard.com"
    ],
    "subject_patterns": [
      "中信银行信用卡电子账单"
    ],
    "body_signatures": [
      "账单日",
      "还款日",
      "本期应还"
    ]
  },
  "extract_rules": {
    "statement_fields": {
      "statement_month": {
        "type": "regex",
        "source": "body_text",
        "pattern": "((?:20\\d{2})年(?:0?[1-9]|1[0-2])月)(?:账单|对账单)",
        "required": false
      },
      "statement_date": {
        "type": "regex",
        "source": "body_text",
        "pattern": "(?:账单日|账单日期)[:：]?\\s*(20\\d{2}[-/.年]\\d{1,2}[-/.月]\\d{1,2}(?:日)?)",
        "required": false
      },
      "due_date": {
        "type": "regex",
        "source": "body_text",
        "pattern": "(?:到期还款日|最后还款日|还款日)[:：]?\\s*(20\\d{2}[-/.年]\\d{1,2}[-/.月]\\d{1,2}(?:日)?)",
        "required": false
      },
      "total_due": {
        "type": "regex",
        "source": "body_text",
        "pattern": "(?:本期应还款总额|本期应还款金额|本期应还金额|本期应还)[:：]?\\s*(?:CNY|RMB|[￥¥$])?\\s*([+-]?[0-9,]+(?:\\.[0-9]{1,2})?)",
        "required": false
      },
      "minimum_due": {
        "type": "regex",
        "source": "body_text",
        "pattern": "(?:本期最低还款额|最低还款额|最低应还款)[:：]?\\s*(?:CNY|RMB|[￥¥$])?\\s*([+-]?[0-9,]+(?:\\.[0-9]{1,2})?)",
        "required": false
      }
    }
  },
  "normalize_rules": {
    "date_formats": [
      "%Y-%m-%d",
      "%Y/%m/%d",
      "%Y.%m.%d",
      "%Y年%m月%d日",
      "%Y年%m月%d"
    ],
    "amount_strip_tokens": [
      ",",
      " ",
      "RMB",
      "CNY",
      "￥",
      "¥"
    ]
  },
  "validate_rules": {
    "required_statement_fields": [
      "total_due"
    ],
    "rules": [
      {
        "id": "due_date_not_earlier",
        "severity": "warning",
        "type": "date_compare",
        "left": "due_date",
        "op": ">=",
        "right": "statement_date",
        "skip_if_missing": true
      },
      {
        "id": "minimum_le_total",
        "severity": "warning",
        "type": "amount_compare",
        "left": "minimum_due",
        "op": "<=",
        "right": "total_due",
        "skip_if_missing": true
      }
    ]
  }
}