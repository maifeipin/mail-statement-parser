{
  "schema_version": "1.0",
  "rule_id": "CMB_TEMPLATE_V1",
  "bank_code": "CMB",
  "status": "active",
  "priority": 95,
  "match_rules": {
    "sender_patterns": [
      "ccsvc@message.cmbchina.com"
    ],
    "subject_patterns": [
      "招商银行信用卡电子账单"
    ],
    "body_signatures": [
      "账单日",
      "到期还款日",
      "本期应还金额"
    ]
  },
  "extract_rules": {
    "statement_fields": {
      "statement_month": {
        "type": "regex",
        "source": "body_text",
        "pattern": "(20\\d{2}/\\d{2}/\\d{2})\\s*-\\s*(20\\d{2}/\\d{2}/\\d{2})",
        "group": 2,
        "required": true
      },
      "statement_date": {
        "type": "regex",
        "source": "body_text",
        "pattern": "(20\\d{2}/\\d{2}/\\d{2})\\s*-\\s*(20\\d{2}/\\d{2}/\\d{2})",
        "group": 2,
        "required": true
      },
      "due_date": {
        "type": "regex",
        "source": "body_text",
        "pattern": "(?:到期还款日|最后还款日)[:：]?\\s*(20\\d{2}[-/.年]\\d{1,2}[-/.月]\\d{1,2}(?:日)?)",
        "required": false,
        "source_probe": {
          "label_pattern": "(?:到期还款日|最后还款日|Payment\\s*Due\\s*Date)",
          "region_pattern": "(?:本期应还金额|账单日|上期应还金额)"
        },
        "html_element_id": "paymentDueDate"
      },
      "total_due": {
        "type": "regex",
        "source": "body_text",
        "pattern": "\\|\\s*\\|\\s*\\|\\s*[¥￥]\\s*(-?[0-9,]+(?:\\.[0-9]{1,2})?)\\s*\\|\\s*\\|\\s*[¥￥]\\s*(-?[0-9,]+(?:\\.[0-9]{1,2})?)\\s*\\|",
        "group": 1,
        "required": true,
        "source_probe": {
          "label_pattern": "本期应还金额",
          "region_pattern": "(?:本期应还金额|账单日|上期应还金额)"
        },
        "html_element_id": "L1rmbLcurrBal"
      },
      "minimum_due": {
        "type": "regex",
        "source": "body_text",
        "pattern": "\\|\\s*\\|\\s*\\|\\s*[¥￥]\\s*(-?[0-9,]+(?:\\.[0-9]{1,2})?)\\s*\\|\\s*\\|\\s*[¥￥]\\s*(-?[0-9,]+(?:\\.[0-9]{1,2})?)\\s*\\|",
        "group": 2,
        "required": true,
        "source_probe": {
          "label_pattern": "最低还款(?:金额|额)",
          "region_pattern": "(?:本期应还金额|账单日|上期应还金额)"
        },
        "html_element_id": "L1rmbLdueAmt"
      }
    }
  },
  "normalize_rules": {
    "date_formats": [
      "%Y-%m-%d",
      "%Y/%m/%d",
      "%Y.%m.%d",
      "%Y年%m月%d日",
      "%Y年%m月%d"
    ],
    "amount_strip_tokens": [
      ",",
      " ",
      "RMB",
      "CNY",
      "￥"
    ]
  },
  "validate_rules": {
    "required_statement_fields": [
      "statement_month",
      "statement_date",
      "total_due",
      "minimum_due"
    ],
    "rules": [
      {
        "id": "due_date_not_earlier",
        "severity": "warning",
        "type": "date_compare",
        "left": "due_date",
        "op": ">=",
        "right": "statement_date",
        "skip_if_missing": true
      },
      {
        "id": "minimum_le_total",
        "severity": "warning",
        "type": "amount_compare",
        "left": "minimum_due",
        "op": "<=",
        "right": "total_due",
        "skip_if_missing": true
      }
    ]
  },
  "template_version": "CMB_TEMPLATE_V1.20261011",
  "quality": {
    "monitor_structure": true,
    "required_fields_by_purpose": {
      "financial_summary": [
        "statement_month",
        "total_due"
      ],
      "repayment_reminder": [
        "statement_month",
        "due_date",
        "total_due"
      ],
      "fx_analysis": [
        "statement_month"
      ]
    },
    "table_header_aliases": {
      "交易日": [
        "交易日期"
      ],
      "记账日": [
        "入账日期",
        "POST DATE"
      ]
    },
    "accepted_structure_fingerprints": [
      {
        "table_headers": [
          [
            "ignored",
            "txn_date",
            "post_date",
            "description",
            "amount",
            "currency",
            "location",
            "original_amount"
          ]
        ]
      }
    ],
    "currency_declaration": {},
    "settlement_cell_symbol": {"￥": "CNY", "¥": "CNY"},
    "settlement_numeric_code_column": true,
    "baseline_provenance": {
      "fixture": "tests/fixtures/cmb_reviewed_statement.eml",
      "basis": "Synthetic regression derived from the existing eight-column CMB parser contract and user-supplied GOOGLE*CHATGPT row; not a newly collected bank template",
      "scope": "Current eight-column contract only; real bank template coverage awaits sanitized source samples"
    }
  }
}
