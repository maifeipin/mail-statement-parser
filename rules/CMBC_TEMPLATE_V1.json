{
  "schema_version": "1.0",
  "rule_id": "CMBC_TEMPLATE_V1",
  "bank_code": "CMBC",
  "status": "active",
  "priority": 92,
  "match_rules": {
    "sender_patterns": [
      "master@creditcard.cmbc.com.cn"
    ],
    "subject_patterns": [
      "民生信用卡",
      "电子对账单"
    ],
    "body_signatures": [
      "本期应还",
      "最低还款",
      "还款日"
    ]
  },
  "extract_rules": {
    "statement_fields": {
      "statement_month": {
        "type": "regex",
        "source": "subject",
        "pattern": "((?:20\\d{2})年(?:0?[1-9]|1[0-2])月)",
        "required": true
      },
      "statement_date": {
        "type": "regex",
        "source": "body_text",
        "pattern": "(?:本期账单日|账单日|账单日期)[\\s\\S]{0,220}?(20\\d{2}[-/.]\\d{1,2}[-/.]\\d{1,2})",
        "required": false
      },
      "due_date": {
        "type": "regex",
        "source": "body_text",
        "pattern": "(?:本期最后还款日|到期还款日|最后还款日|还款日)[\\s\\S]{0,220}?(20\\d{2}[-/.]\\d{1,2}[-/.]\\d{1,2})",
        "required": false
      },
      "total_due": {
        "type": "regex",
        "source": "body_text",
        "pattern": "(?:\\|[^\\n]*?(?:本期应还款金额|本期应还金额|本期应还款|本期应还)[^\\n]*?\\|[\\s\\S]{0,220}?|(?:RMB/USD\\s*Account|人民币/美元账户)[^\\n]{0,220}?)(?:RMB|￥|¥|CNY)\\s*([+-]?[0-9]{1,3}(?:,[0-9]{3})*(?:\\.[0-9]{2}))",
        "required": false
      },
      "minimum_due": {
        "type": "regex",
        "source": "body_text",
        "pattern": "(?:\\|[^\\n]*?(?:本期最低还款金额|本期最低还款|最低还款额|最低应还款)[^\\n]*?\\|[\\s\\S]{0,240}?|(?:RMB/USD\\s*Account|人民币/美元账户)[^\\n]{0,260}?(?:RMB|￥|¥|CNY)\\s*[+-]?[0-9]{1,3}(?:,[0-9]{3})*(?:\\.[0-9]{2})[^\\n]{0,120}?)(?:RMB|￥|¥|CNY)\\s*([+-]?[0-9]{1,3}(?:,[0-9]{3})*(?:\\.[0-9]{2}))",
        "required": false
      }
    }
  },
  "normalize_rules": {
    "date_formats": [
      "%Y-%m-%d",
      "%Y/%m/%d",
      "%Y.%m.%d",
      "%Y年%m月%d日",
      "%Y年%m月%d"
    ],
    "amount_strip_tokens": [
      ",",
      " ",
      "RMB",
      "CNY",
      "￥",
      "¥"
    ]
  },
  "validate_rules": {
    "required_statement_fields": [
      "statement_month"
    ],
    "rules": [
      {
        "id": "due_date_not_earlier",
        "severity": "warning",
        "type": "date_compare",
        "left": "due_date",
        "op": ">=",
        "right": "statement_date",
        "skip_if_missing": true
      },
      {
        "id": "minimum_le_total",
        "severity": "warning",
        "type": "amount_compare",
        "left": "minimum_due",
        "op": "<=",
        "right": "total_due",
        "skip_if_missing": true
      }
    ]
  }
}
