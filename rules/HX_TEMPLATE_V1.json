{
  "schema_version": "1.0",
  "rule_id": "HX_TEMPLATE_V1",
  "bank_code": "HX",
  "status": "active",
  "priority": 100,
  "match_rules": {
    "sender_patterns": [
      "admin@creditcardmail.hxb.com.cn"
    ],
    "subject_patterns": [
      "华夏信用卡-电子账单"
    ],
    "body_signatures": [
      "账单日",
      "到期还款日"
    ]
  },
  "extract_rules": {
    "statement_fields": {
      "statement_month": {
        "type": "regex",
        "source": "subject",
        "pattern": "((?:20\\d{2})年(?:0?[1-9]|1[0-2])月)",
        "required": true
      },
      "statement_date": {
        "type": "regex",
        "source": "body_text",
        "pattern": "(?:账单日)\\s*(每月\\d{1,2}日|20\\d{2}[-/.年]\\d{1,2}[-/.月]\\d{1,2}(?:日)?)",
        "required": true
      },
      "due_date": {
        "type": "regex",
        "source": "body_text",
        "pattern": "(?:到期还款日|最后还款日)\\s*(20\\d{2}[-/.年]\\d{1,2}[-/.月]\\d{1,2}(?:日)?)",
        "required": true
      },
      "total_due": {
        "type": "regex",
        "source": "body_text",
        "pattern": "(?:本期应还金额|本期应还款)\\s*[＄$]?[0-9,]+(?:\\.[0-9]{1,2})?\\s*[￥$]?([+-]?[0-9,]+(?:\\.[0-9]{1,2})?)",
        "required": false
      },
      "minimum_due": {
        "type": "regex",
        "source": "body_text",
        "pattern": "(?:最低还款额|最低应还款)\\s*[＄$]?[0-9,]+(?:\\.[0-9]{1,2})?\\s*[￥$]?([+-]?[0-9,]+(?:\\.[0-9]{1,2})?)",
        "required": false
      }
    }
  },
  "normalize_rules": {
    "date_formats": [
      "%Y-%m-%d",
      "%Y/%m/%d",
      "%Y.%m.%d",
      "%Y年%m月%d日",
      "%Y年%m月%d"
    ],
    "amount_strip_tokens": [
      ",",
      " ",
      "RMB",
      "CNY",
      "￥"
    ]
  },
  "validate_rules": {
    "required_statement_fields": [
      "statement_month",
      "statement_date",
      "due_date"
    ],
    "rules": [
      {
        "id": "due_date_not_earlier",
        "severity": "error",
        "type": "date_compare",
        "left": "due_date",
        "op": ">=",
        "right": "statement_date"
      },
      {
        "id": "minimum_le_total",
        "severity": "warning",
        "type": "amount_compare",
        "left": "minimum_due",
        "op": "<=",
        "right": "total_due",
        "skip_if_missing": true
      }
    ]
  },
  "template_version": "HX_TEMPLATE_V1.20261011",
  "quality": {
    "monitor_structure": true,
    "required_fields_by_purpose": {
      "financial_summary": [
        "statement_month",
        "total_due"
      ],
      "repayment_reminder": [
        "statement_month",
        "due_date",
        "total_due"
      ],
      "fx_analysis": [
        "statement_month"
      ]
    },
    "table_header_aliases": {},
    "accepted_structure_fingerprints": [
      {
        "table_headers": [
          [
            "txn_date",
            "post_date",
            "description",
            null,
            "amount"
          ]
        ],
        "column_counts": [
          5
        ],
        "table_block_count": 1
      }
    ],
    "currency_declaration": {},
    "settlement_cell_symbol": {
      "￥": "CNY",
      "¥": "CNY"
    },
    "baseline_provenance": {
      "basis": "Reviewed original MIME, verified SHA-256 and 111-row detail table; isolated reparse preserves monetary fields and transaction multiplicity",
      "source_raw_sha256": "7a1e2c2ef8e4b8542fbb7e5b17e9526a4c563d802a2517ad21b73b2b9c449b9c",
      "reviewed_on": "2026-10-14",
      "scope": "Five-column HX detail table only; historical two-table variants not approved"
    }
  }
}
