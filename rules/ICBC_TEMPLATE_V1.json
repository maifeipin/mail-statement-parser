{
  "schema_version": "1.0",
  "rule_id": "ICBC_TEMPLATE_V1",
  "bank_code": "ICBC",
  "status": "active",
  "priority": 95,
  "match_rules": {
    "sender_patterns": [
      "webmaster@icbc.com.cn"
    ],
    "subject_patterns": [
      "中国工商银行客户对账单",
      "ICBC Peony Card Bank Statement"
    ],
    "body_signatures": [
      "账单周期",
      "对账单生成日",
      "需 还 款 明 细"
    ]
  },
  "extract_rules": {
    "statement_fields": {
      "statement_month": {
        "type": "regex",
        "source": "body_text",
        "pattern": "账单周期\\s*(20\\d{2}年\\d{1,2}月\\d{1,2}日)\\s*-\\s*(20\\d{2}年\\d{1,2}月\\d{1,2}日)",
        "group": 2,
        "required": true
      },
      "statement_date": {
        "type": "regex",
        "source": "body_text",
        "pattern": "(?:对账单生成日|对账单生成日\\s*)\\s*(20\\d{2}年\\d{1,2}月\\d{1,2}日)",
        "required": true
      },
      "due_date": {
        "type": "regex",
        "source": "body_text",
        "pattern": "贷记卡到期还款日\\s*(20\\d{2}年\\d{1,2}月\\d{1,2}日)",
        "required": false
      },
      "total_due": {
        "type": "regex",
        "source": "body_text",
        "pattern": "合计\\s*人民币元\\s*([0-9]{1,3}(?:,[0-9]{3})*(?:\\.[0-9]{2})?)/RMB\\s*([0-9]{1,3}(?:,[0-9]{3})*(?:\\.[0-9]{2})?)/RMB",
        "group": 1,
        "required": true
      },
      "minimum_due": {
        "type": "regex",
        "source": "body_text",
        "pattern": "合计\\s*人民币元\\s*([0-9]{1,3}(?:,[0-9]{3})*(?:\\.[0-9]{2})?)/RMB\\s*([0-9]{1,3}(?:,[0-9]{3})*(?:\\.[0-9]{2})?)/RMB",
        "group": 2,
        "required": true
      }
    }
  },
  "normalize_rules": {
    "date_formats": [
      "%Y-%m-%d",
      "%Y/%m/%d",
      "%Y.%m.%d",
      "%Y年%m月%d日",
      "%Y年%m月%d"
    ],
    "amount_strip_tokens": [
      ",",
      " ",
      "RMB",
      "CNY",
      "￥"
    ]
  },
  "validate_rules": {
    "required_statement_fields": [
      "statement_month",
      "statement_date",
      "total_due",
      "minimum_due"
    ],
    "rules": [
      {
        "id": "due_date_not_earlier",
        "severity": "warning",
        "type": "date_compare",
        "left": "due_date",
        "op": ">=",
        "right": "statement_date",
        "skip_if_missing": true
      },
      {
        "id": "minimum_le_total",
        "severity": "warning",
        "type": "amount_compare",
        "left": "minimum_due",
        "op": "<=",
        "right": "total_due",
        "skip_if_missing": true
      }
    ]
  }
}
